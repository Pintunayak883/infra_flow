# Server
PORT=5000
NODE_ENV=development
ALLOW_PORT_FALLBACK=false

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/infraflow
MONGO_DB_NAME=infraflow

# Auth
JWT_SECRET=replace-with-strong-secret
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
AUTHORITY_EMAIL=admin@gmail.com
AUTHORITY_PASSWORD=admin123

# Frontend + sockets
CLIENT_ORIGIN=http://localhost:5173
SOCKET_ORIGIN=http://localhost:5173

# Optional vendor APIs
OPENAI_API_KEY=
